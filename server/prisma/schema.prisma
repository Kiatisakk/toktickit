// TokTickIT database schema.
// The connection URL comes from prisma.config.ts, which reads server/.env.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// What a User is allowed to do. Lab 2 seeds only REQUESTER.
///
/// All three values exist from the start even though two are unreachable this
/// sprint. Lab 3 introduces authentication and the other two roles; defining
/// them now means that lab adds rows and behaviour rather than migrating an
/// enum, and it keeps the schema aligned with the three roles CONTEXT.md
/// already defines. See specification.md decision D-01.
enum Role {
  REQUESTER
  IT_STAFF
  ADMIN
}

/// An account in TokTickIT.
///
/// In Lab 2 a User is only ever a Development Requester: a seeded identity the
/// selection screen offers so that requester-scoped behaviour can be exercised
/// before login exists. There is no password, no session and no token here, and
/// the `X-Development-Requester-Id` header that names one is not a credential —
/// see BR-03.
///
/// Named `User` rather than `RequesterUser` deliberately. Lab 3 replaces the
/// header with a real authenticated identity, which under this model is a new
/// column and new rows rather than a table rename and a rewrite of every
/// foreign key pointing at it.
model User {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique

  role Role @default(REQUESTER)

  /// Inactive users never appear in the selector and can never become the
  /// current context (BR-07). Deactivating rather than deleting keeps the
  /// tickets they own intact.
  isActive Boolean @default(true)

  /// The scrypt hash of the account's password, never the password (BR-06).
  ///
  /// NOT NULL, because an account able to sign in with a null hash would be an
  /// account with no password. It arrived nullable and was tightened one
  /// migration later, with `prisma/bootstrap-passwords.ts` in between: the
  /// constraint could not be added to populated rows in one step, and SQL
  /// cannot derive a scrypt hash because the hashing lives in Node (§7).
  ///
  /// The sign-in path still refuses a row it cannot verify rather than trusting
  /// the constraint, so a database restored from before this migration fails
  /// closed.
  passwordHash String

  /// Set when an Administrator issues a starting password, cleared by the
  /// user's own change (BR-02). While it is set, every endpoint except reading
  /// the current user, changing the password and signing out is refused.
  mustChangePassword Boolean @default(false)

  createdAt DateTime @default(now())

  /// Every session this account currently holds. A user may hold several at
  /// once (BR-12); changing a password deletes all but the current one (BR-14).
  sessions Session[]

  /// Tickets this user raised.
  tickets Ticket[] @relation("TicketRequester")

  /// Two named relations because a user can be on both ends of one attachment:
  /// the person who uploaded it and, later, the person who removed it.
  uploadedAttachments Attachment[] @relation("AttachmentUploader")
  removedAttachments  Attachment[] @relation("AttachmentRemover")

  /// Tickets this user is responsible for. Empty throughout Lab 2 — nothing can
  /// set an owner until IT Staff exist.
  ownedTickets Ticket[] @relation("TicketOwner")

  /// Public Comments this user wrote. Kept when the user is deactivated, so a
  /// conversation never loses a speaker (BR-36).
  publicComments PublicComment[]

  // The selector reads active users on every load.
  @@index([isActive])
}

/// The kind of request a Ticket represents — reference data, not free text.
/// Lab 1 seeds four: Account and Access, Hardware, Software, Network.
model Category {
  id   Int    @id @default(autoincrement())
  name String @unique

  /// The order categories are presented in, independent of `id`.
  ///
  /// `id` is a serial: it records when a row was inserted, not where it belongs
  /// in a list. Renaming a category re-creates its row and hands it a fresh id,
  /// which silently moves it to the end. This column is what the API sorts on,
  /// so presentation order survives that.
  displayOrder Int @unique

  /// Retired categories stop being offered but keep existing, so tickets that
  /// already reference one are never orphaned. From Lab 2 onwards reference
  /// data is deactivated rather than deleted.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  tickets Ticket[]
}

/// The system or asset a Ticket is about — a service, application, device or
/// platform. Reference data, like Category.
///
/// Category and Related System are deliberately independent: Category says what
/// kind of problem, Related System says what the problem is about. §5.1 of the
/// labsheet lists the required relationships and none connects the two, and the
/// handout's own example list has no Related System that belongs to "Account
/// and Access" — a dependent dropdown would produce a category that cannot be
/// submitted. See decision D-06.
model RelatedSystem {
  id   Int    @id @default(autoincrement())
  name String @unique

  /// Presentation order, kept separate from `id` for the same reason Category
  /// keeps one.
  displayOrder Int @unique

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  tickets Ticket[]
}

/// How urgent a Ticket is. Used by both Requested Priority and IT Priority —
/// the product deliberately keeps the two apart, so they share a scale but not
/// a column (see CONTEXT.md).
enum Priority {
  LOW
  MEDIUM
  HIGH
}

/// Where a Ticket is in its lifecycle (BR-24).
///
/// The order is the lifecycle's own, not alphabetical, because the queue sorts
/// on it: a list ordered by status should read New, Open, In Progress and so on
/// (api-spec.md §7). `WAITING_FOR_REQUESTER` therefore keeps the position
/// `PENDING` held — the migration renames the value in place rather than adding
/// one and dropping the other, which would have moved it to the end and taken
/// every existing row's value with it (D-11).
///
/// Lab 2 could only ever reach NEW. Lab 3 adds the two the workflow needs at
/// its ends: a ticket can come back (REOPENED) and a ticket can be abandoned
/// (CANCELLED), which is terminal (BR-26).
enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

/// A single IT service request.
model Ticket {
  id Int @id @default(autoincrement())

  /// The number a person quotes when they ring up about this ticket, in the
  /// form TKT-<year>-<six digits>. Generated by the server and unique (BR-01).
  ///
  /// Kept separate from `id` on purpose: `id` is an implementation detail that
  /// leaks how many rows exist, and it cannot restart each year.
  ticketNumber String @unique

  requester   User @relation("TicketRequester", fields: [requesterId], references: [id])
  requesterId Int

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int

  relatedSystem   RelatedSystem @relation(fields: [relatedSystemId], references: [id])
  relatedSystemId Int

  summary     String
  description String

  requestedPriority Priority

  /// IT's own view of urgency, independent of what the Requester asked for
  /// (BR-22, BR-23). Set at creation to a copy of Requested Priority, and only
  /// IT Staff or an Administrator may change it afterwards.
  ///
  /// Still nullable: the contract lets staff clear it back to unset
  /// (api-spec.md §7), and Lab 2's rows had no value at all until the migration
  /// that copied one in.
  itPriority Priority?

  currentStatus TicketStatus @default(NEW)

  /// Unset in Lab 2, for the same reason as itPriority. Two relations from
  /// Ticket to User means both have to be named.
  ticketOwner   User? @relation("TicketOwner", fields: [ticketOwnerId], references: [id])
  ticketOwnerId Int?

  /// Unset in Lab 2. The illustration draws this as italic placeholder text,
  /// which is what an empty field looks like rather than an absent one.
  resolutionSummary String?

  /// When the Requester said the problem appears resolved (FR-18). A timestamp
  /// and not a status, because BR-05 forbids a Requester setting one (D-10).
  /// Set once: indicating twice keeps the first time (BR-27).
  resolvedIndicatedAt DateTime?

  /// `createdAt` is what the UI labels "Ticket Date". One timestamp, one
  /// meaning; a separate date column would only be able to disagree with it.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments Attachment[]

  publicComments PublicComment[]

  // Every My Tickets query filters on owner and orders by creation time. This
  // is the one index the sprint cannot do without.
  @@index([requesterId, createdAt(sort: Desc)])

  // The staff queue reads every ticket in its default order — newest first,
  // id as the tie-break — so the index above, which leads with requesterId,
  // cannot serve it (specification.md §7).
  @@index([createdAt(sort: Desc), id(sort: Desc)])

  // The Unassigned filter and the Owner filter (FR-21).
  @@index([ticketOwnerId])
}

/// The per-year counter behind Ticket Number.
///
/// One row per calendar year, incremented with a single atomic statement inside
/// the same transaction that inserts the ticket. Reading the current maximum and
/// adding one would be a race: two simultaneous submissions read the same value
/// and produce the same number. The unique constraint on Ticket.ticketNumber is
/// the backstop that turns any residual race into a failed insert rather than a
/// duplicate. Decision D-02.
model TicketCounter {
  year       Int @id
  lastNumber Int @default(0)
}

/// A file attached to a Ticket.
///
/// `removedAt` is the single source of truth for soft removal: null means
/// active, a timestamp means removed. There is deliberately no `isActive`
/// boolean beside it — two columns describing one fact admit a state where they
/// contradict each other, and "at most five active" becomes a count of rows
/// where this column is null (BR-23, BR-29, decision D-05).
///
/// `storedFilename` never leaves the server. The name a person uploaded is
/// metadata; the name on disk is generated, so an uploaded filename can never
/// become a path and can never drive an authorization decision (BR-24).
model Attachment {
  id Int @id @default(autoincrement())

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  /// What the person called it. Displayed, never used as a path.
  originalFilename String
  /// What it is called on disk. A generated name, never exposed by the API.
  storedFilename String @unique
  mimeType       String
  sizeBytes      Int

  uploadedById Int
  uploadedBy   User @relation("AttachmentUploader", fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  /// Null while active. Set once, on removal, and never cleared: BR-26 keeps the
  /// record of what was removed and why, which is the point of soft removal.
  removedAt     DateTime?
  removedReason String?
  removedById   Int?
  removedBy     User? @relation("AttachmentRemover", fields: [removedById], references: [id])

  /// The active count in BR-23 is a filtered count per ticket, which is exactly
  /// what this index serves.
  @@index([ticketId, removedAt])
}

/// One signed-in session.
///
/// The token the browser holds is never stored. What is stored is its SHA-256
/// hash, so a disclosed database is a list of expired-looking rows rather than
/// a set of usable sessions (BR-10). Lookup is by that hash, which is why it
/// carries the unique index.
///
/// Nothing about the user is cached here — not the role, not the activation
/// flag. Both are read from the User row on every request, so a deactivation or
/// a role change takes effect on the user's next request rather than at their
/// next sign-in (BR-15, D-02). The cost is one join on a primary key; the
/// benefit is that the Administrator safety rules mean something.
model Session {
  id String @id @default(uuid())

  /// SHA-256 of the opaque token held in the cookie. Not the token.
  tokenHash String @unique

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// Eight hours after creation, and never renewed by activity (BR-11, A-02).
  expiresAt DateTime

  /// Ending a user's other sessions is one statement, and this is what makes it
  /// one statement rather than a scan (BR-14).
  @@index([userId])
}

/// A message on a ticket that its Requester can read (BR-04).
///
/// A table of its own rather than a visibility flag shared with Internal Notes
/// (D-09): no query on this model can reach note content, whatever it forgets
/// to filter.
///
/// Append-only (BR-28) — no `updatedAt`, because nothing may change a row.
model PublicComment {
  id Int @id @default(autoincrement())

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  /// From the session, never from the request body (BR-29).
  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  /// Trimmed, 1 to 5000 characters (BR-30). Stored as text and rendered as
  /// text (BR-31).
  body String

  /// From the server clock (BR-29).
  createdAt DateTime @default(now())

  // A ticket's conversation is read oldest first, with id breaking a tie.
  @@index([ticketId, createdAt, id])
}
