// TokTickIT database schema.
// The connection URL comes from prisma.config.ts, which reads server/.env.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// What a User is allowed to do. Lab 2 seeds only REQUESTER.
///
/// All three values exist from the start even though two are unreachable this
/// sprint. Lab 3 introduces authentication and the other two roles; defining
/// them now means that lab adds rows and behaviour rather than migrating an
/// enum, and it keeps the schema aligned with the three roles CONTEXT.md
/// already defines. See specification.md decision D-01.
enum Role {
  REQUESTER
  IT_STAFF
  ADMIN
}

/// An account in TokTickIT.
///
/// In Lab 2 a User is only ever a Development Requester: a seeded identity the
/// selection screen offers so that requester-scoped behaviour can be exercised
/// before login exists. There is no password, no session and no token here, and
/// the `X-Development-Requester-Id` header that names one is not a credential —
/// see BR-03.
///
/// Named `User` rather than `RequesterUser` deliberately. Lab 3 replaces the
/// header with a real authenticated identity, which under this model is a new
/// column and new rows rather than a table rename and a rewrite of every
/// foreign key pointing at it.
model User {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique

  role Role @default(REQUESTER)

  /// Inactive users never appear in the selector and can never become the
  /// current context (BR-07). Deactivating rather than deleting keeps the
  /// tickets they own intact.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  /// Tickets this user raised.
  tickets Ticket[] @relation("TicketRequester")

  /// Tickets this user is responsible for. Empty throughout Lab 2 — nothing can
  /// set an owner until IT Staff exist.
  ownedTickets Ticket[] @relation("TicketOwner")

  // The selector reads active users on every load.
  @@index([isActive])
}

/// The kind of request a Ticket represents — reference data, not free text.
/// Lab 1 seeds four: Account and Access, Hardware, Software, Network.
model Category {
  id   Int    @id @default(autoincrement())
  name String @unique

  /// The order categories are presented in, independent of `id`.
  ///
  /// `id` is a serial: it records when a row was inserted, not where it belongs
  /// in a list. Renaming a category re-creates its row and hands it a fresh id,
  /// which silently moves it to the end. This column is what the API sorts on,
  /// so presentation order survives that.
  displayOrder Int @unique

  /// Retired categories stop being offered but keep existing, so tickets that
  /// already reference one are never orphaned. From Lab 2 onwards reference
  /// data is deactivated rather than deleted.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  tickets Ticket[]
}

/// The system or asset a Ticket is about — a service, application, device or
/// platform. Reference data, like Category.
///
/// Category and Related System are deliberately independent: Category says what
/// kind of problem, Related System says what the problem is about. §5.1 of the
/// labsheet lists the required relationships and none connects the two, and the
/// handout's own example list has no Related System that belongs to "Account
/// and Access" — a dependent dropdown would produce a category that cannot be
/// submitted. See decision D-06.
model RelatedSystem {
  id   Int    @id @default(autoincrement())
  name String @unique

  /// Presentation order, kept separate from `id` for the same reason Category
  /// keeps one.
  displayOrder Int @unique

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  tickets Ticket[]
}

/// How urgent a Ticket is. Used by both Requested Priority and IT Priority —
/// the product deliberately keeps the two apart, so they share a scale but not
/// a column (see CONTEXT.md).
enum Priority {
  LOW
  MEDIUM
  HIGH
}

/// Where a Ticket is in its lifecycle.
///
/// Only NEW is reachable in Lab 2: §4.2 excludes every status change after
/// creation. The rest are defined anyway, because they cost nothing now, they
/// save an enum migration in Lab 4, and they give the My Tickets status filter
/// something to return nothing for — which is how the required no-results state
/// gets demonstrated (BR-35).
enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  PENDING
  RESOLVED
  CLOSED
}

/// A single IT service request.
model Ticket {
  id Int @id @default(autoincrement())

  /// The number a person quotes when they ring up about this ticket, in the
  /// form TKT-<year>-<six digits>. Generated by the server and unique (BR-01).
  ///
  /// Kept separate from `id` on purpose: `id` is an implementation detail that
  /// leaks how many rows exist, and it cannot restart each year.
  ticketNumber String @unique

  requester   User @relation("TicketRequester", fields: [requesterId], references: [id])
  requesterId Int

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int

  relatedSystem   RelatedSystem @relation(fields: [relatedSystemId], references: [id])
  relatedSystemId Int

  summary     String
  description String

  requestedPriority Priority

  /// Unset in Lab 2. §4.2 excludes IT Staff changing priority, but the approved
  /// Ticket Detail illustration shows the field, so it exists and renders as a
  /// placeholder. Decision D-04.
  itPriority Priority?

  currentStatus TicketStatus @default(NEW)

  /// Unset in Lab 2, for the same reason as itPriority. Two relations from
  /// Ticket to User means both have to be named.
  ticketOwner   User? @relation("TicketOwner", fields: [ticketOwnerId], references: [id])
  ticketOwnerId Int?

  /// Unset in Lab 2. The illustration draws this as italic placeholder text,
  /// which is what an empty field looks like rather than an absent one.
  resolutionSummary String?

  /// `createdAt` is what the UI labels "Ticket Date". One timestamp, one
  /// meaning; a separate date column would only be able to disagree with it.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Every My Tickets query filters on owner and orders by creation time. This
  // is the one index the sprint cannot do without.
  @@index([requesterId, createdAt(sort: Desc)])
}

/// The per-year counter behind Ticket Number.
///
/// One row per calendar year, incremented with a single atomic statement inside
/// the same transaction that inserts the ticket. Reading the current maximum and
/// adding one would be a race: two simultaneous submissions read the same value
/// and produce the same number. The unique constraint on Ticket.ticketNumber is
/// the backstop that turns any residual race into a failed insert rather than a
/// duplicate. Decision D-02.
model TicketCounter {
  year       Int @id
  lastNumber Int @default(0)
}
