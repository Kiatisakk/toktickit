// TokTickIT database schema.
// The connection URL comes from prisma.config.ts, which reads server/.env.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// The kind of request a Ticket represents — reference data, not free text.
/// Lab 1 seeds four: Account and Access, Hardware, Software, Network.
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}
