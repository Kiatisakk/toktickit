# Copy this file to server/.env.test — it is git-ignored.
#
# Tests run against their own database in the same container as development.
# Sharing one database would mean every test run truncates and reseeds the
# demonstration tickets that the Part 7 screenshots depend on, and those are
# arranged deliberately across four requesters. See specification.md D-11.
DATABASE_URL="postgresql://toktickit:toktickit_dev_password@localhost:5433/toktickit_test?schema=public"
