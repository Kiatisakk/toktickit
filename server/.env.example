# Copy this file to server/.env and adjust if needed.
# server/.env is git-ignored — never commit real credentials.

# Matches the credentials in docker-compose.yml at the repository root.
# Host port is 5433 to avoid clashing with a locally installed PostgreSQL.
DATABASE_URL="postgresql://toktickit:toktickit_dev_password@localhost:5433/toktickit?schema=public"

# Port the Express API listens on.
PORT=3000

# Origin allowed by CORS (the Vite dev server).
CORS_ORIGIN="http://localhost:5173"
