# One .gitignore for the whole repository, matching the required structure in
# the Lab 1 brief. Patterns without a leading slash match at any depth, so
# `node_modules/` covers client/, server/ and the root alike.

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
build/
*.tsbuildinfo

# Generated Prisma client — regenerated by `npm install` and `npm run db:migrate`
server/src/generated/prisma/

# Environment files — secrets must never be committed.
# Only the .env.example templates are tracked.
.env
.env.*
!.env.example
!.env.test.example
*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / tooling caches
coverage/
.vite/
.vitest/

# Agent configuration written by tooling — CLAUDE.md at the root is tracked,
# but the .claude/ directory holds machine-local state.
.claude/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.sw?

# Uploaded attachments. Generated names, real user content — never in git.
server/uploads/
